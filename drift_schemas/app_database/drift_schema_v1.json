  "fixed_sql": [
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"dosage_amount\" REAL NOT NULL, \"dosage_unit\" TEXT NOT NULL, \"form\" TEXT NOT NULL, \"weekdays\" INTEGER NOT NULL CHECK(\"weekdays\" BETWEEN 1 AND 127), \"start_date\" INTEGER NOT NULL, \"end_date\" INTEGER NULL, \"note\" TEXT NULL, \"color_value\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"medication_id\" INTEGER NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"minute_of_day\" INTEGER NOT NULL CHECK(\"minute_of_day\" BETWEEN 0 AND 1439), UNIQUE (\"medication_id\", \"minute_of_day\"));"
        }
      ]
    },
    {
      "name": "intakes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intakes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"medication_id\" INTEGER NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"scheduled_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"recorded_at\" INTEGER NOT NULL, UNIQUE (\"medication_id\", \"scheduled_at\"));"
        }
      ]
    },
    {
      "name": "wellbeing_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wellbeing_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL UNIQUE, \"mood\" INTEGER NOT NULL CHECK(\"mood\" BETWEEN 1 AND 5), \"symptoms\" TEXT NOT NULL DEFAULT '[]', \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "intakes_scheduled_at",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX intakes_scheduled_at ON intakes (scheduled_at)"
        }
      ]
    }
  ]
